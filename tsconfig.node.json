{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "scripts/**/*.mjs",
    "mcp/**/*.ts",
    "src/core/ai/**/*.ts",
    "src/core/integrations/**/*.ts",
    "src/core/policy/**/*.ts",
    "src/core/pricing/**/*.ts",
    "src/core/scopePhotos/**/*.ts",
    "src/domain/**/*.ts"
  ]
}

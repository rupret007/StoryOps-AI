# StoryOps AI environment template
#
# Safe defaults run the application entirely in sandbox mode. Copy this file to
# .env.local and add secrets only when activating a live provider. Never commit
# .env.local. Variables beginning with VITE_ are embedded in the browser bundle
# and MUST NOT contain secrets.

# Application -----------------------------------------------------------------
STORYOPS_PROVIDER_MODE=sandbox
STORYOPS_PORT=8080
STORYOPS_BUILD_REVISION=local-uncommitted

# Public browser configuration (never secrets) --------------------------------
VITE_STORYOPS_ENV=sandbox
# Set to supabase only when the public URL, public anon key, and company UUID
# below are present. Never place a service-role key in any VITE_ variable.
VITE_STORYOPS_DATA_MODE=sandbox
VITE_STORYOPS_TIME_ZONE=America/Chicago
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STORYOPS_COMPANY_ID=
VITE_INTEGRATION_HEALTH_REFRESH_SECONDS=60

# Supabase (server/operations only) --------------------------------------------
# Prefer STORYOPS_DATABASE_URL in the shell instead of placing a database
# password in this file. The local Supabase default is selected by backup and
# restore scripts when --local is used.
STORYOPS_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Trusted identity provisioning (server only) ---------------------------------
# Disabled never submits invitation email. Live mode requires the service-role
# key above plus one reviewed HTTPS redirect owned by this deployment. Provider
# acceptance is recorded as submission only; it never claims inbox delivery.
STORYOPS_IDENTITY_INVITE_LIVE_ENABLED=false
STORYOPS_IDENTITY_INVITE_MODE=disabled
STORYOPS_IDENTITY_INVITE_REDIRECT_URL=http://127.0.0.1:5173/access
IDENTITY_PROVISIONING_RATE_LIMIT_PER_HOUR=30

# OpenAI (server only) ---------------------------------------------------------
# Outbound provider calls require both the provider MODE=live and the matching
# explicit capability flag=true. A mode, flag, or credential alone never enables
# a real call. MODE=disabled disables sandbox behavior too.
OPENAI_MODE=sandbox
OPENAI_LIVE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PROJECT_ID=
OPENAI_VISION_LIVE_ENABLED=false
OPENAI_VISION_MODEL=
PHOTO_ANALYSIS_RATE_LIMIT_PER_MINUTE=20
AI_OFFICE_MAX_OUTPUT_TOKENS=2000
AI_OFFICE_RUNS_PER_USER_PER_HOUR=30
AI_OFFICE_RUNS_PER_COMPANY_PER_DAY=250
AI_OFFICE_DAILY_TOKEN_BUDGET=1000000
INTEGRATION_HEALTH_RATE_LIMIT_PER_HOUR=12

# Twilio SMS and voice (server only) -------------------------------------------
TWILIO_MODE=sandbox
TWILIO_LIVE_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=
TWILIO_WEBHOOK_URL=
TWILIO_COMPANY_ID=
OUTBOUND_MESSAGES_PER_COMPANY_PER_MINUTE=60
OUTBOUND_SMS_PER_CONTACT_PER_HOUR=30
OUTBOUND_EMAIL_PER_CONTACT_PER_HOUR=20
OUTBOUND_VOICE_PER_CONTACT_PER_HOUR=5

# Normalized multi-channel lead intake (server only) ---------------------------
# The sandbox boundary accepts only loopback/local-Supabase traffic plus its
# explicit sandbox header. Live web/chat/email events use timestamped HMAC; live
# SMS/voice events use Twilio's request signature. Both MODE=live and the
# independent live flag are required. Keep the inbound URL distinct from the
# delivery/status callback URL; duplicate fan-out is durably deduplicated.
LEAD_INTAKE_MODE=sandbox
LEAD_INTAKE_LIVE_ENABLED=false
LEAD_INTAKE_COMPANY_ID=
LEAD_INTAKE_SIGNING_SECRET=
TWILIO_LEAD_INTAKE_WEBHOOK_URL=
LEAD_INTAKE_COMPANY_RATE_LIMIT_PER_MINUTE=120
LEAD_INTAKE_CONTACT_RATE_LIMIT_PER_HOUR=30

# Email (server-only token-authenticated HTTPS provider adapter) ----------------
EMAIL_MODE=sandbox
EMAIL_LIVE_ENABLED=false
EMAIL_PROVIDER=sandbox
EMAIL_PROVIDER_ENDPOINT=
EMAIL_PROVIDER_HEALTH_URL=
EMAIL_PROVIDER_TOKEN=
EMAIL_FROM=
EMAIL_WEBHOOK_SECRET=

# Private outbound executors (server/scheduler only) ---------------------------
# Each token must be an independent random value of at least 32 bytes. Never
# reuse SUPABASE_SERVICE_ROLE_KEY, another worker token, a provider credential,
# or any VITE_ value. The service-role key remains internal to the Edge runtime.
# Modes are disabled, manual, or scheduled. A request must declare the same
# trigger. Batch size is hard-limited to 25 and lease duration to 30–300 seconds.
# Set this to a bare immutable image digest, commit SHA, or platform deployment
# ID for the running Edge release (letters, digits, period, underscore, and
# hyphen only). Live worker readiness fails closed if it is absent/invalid and
# old-release heartbeats never authorize a new release.
STORYOPS_RELEASE_ID=
POST_SERVICE_WORKER_MODE=disabled
POST_SERVICE_WORKER_TOKEN=
POST_SERVICE_WORKER_SCHEDULE_INTERVAL_SECONDS=900
TRANSACTIONAL_OUTBOUND_WORKER_MODE=disabled
TRANSACTIONAL_OUTBOUND_WORKER_TOKEN=
TRANSACTIONAL_OUTBOUND_WORKER_SCHEDULE_INTERVAL_SECONDS=60
# Integration health degrades after this oldest-queue age and blocks on any
# submission-unknown record, unavailable queue evidence, or unsafe credential.
OUTBOUND_WORKER_QUEUE_ALERT_AFTER_SECONDS=900

# Stripe (server only) ---------------------------------------------------------
STRIPE_MODE=sandbox
STRIPE_LIVE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://127.0.0.1:5173/portal/payment/success
STRIPE_CHECKOUT_CANCEL_URL=http://127.0.0.1:5173/portal/payment/cancel

# Google Calendar / maps (server only) -----------------------------------------
# The scheduling-evidence worker is separately dual-gated. In sandbox/disabled
# mode it returns a non-bookable response without provider or scheduling writes.
SCHEDULING_EVIDENCE_MODE=sandbox
SCHEDULING_EVIDENCE_LIVE_ENABLED=false
# Separate pre-departure NWS/VROOM gate. Both values must opt into live mode;
# sandbox/disabled responses can never authorize confirmed -> en_route.
DISPATCH_CLEARANCE_MODE=sandbox
DISPATCH_CLEARANCE_LIVE_ENABLED=false
# Private scheduled cleanup of expired, unconsumed live calendar reservations.
# Use a separate random value of at least 32 bytes; never reuse a Supabase key
# or any other private-worker credential.
SCHEDULING_RECONCILIATION_MODE=sandbox
SCHEDULING_RECONCILIATION_LIVE_ENABLED=false
SCHEDULING_RECONCILIATION_TOKEN=
SCHEDULING_RECONCILIATION_SCHEDULE_INTERVAL_SECONDS=120
SCHEDULING_RECONCILIATION_PROVIDER_CALLS_PER_HOUR=60
GOOGLE_CALENDAR_MODE=sandbox
GOOGLE_CALENDAR_LIVE_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
# Short-lived access token is supported for local diagnostics; refresh credentials are preferred.
GOOGLE_CALENDAR_ACCESS_TOKEN=
MAPS_MODE=sandbox
MAPS_LIVE_ENABLED=false
GOOGLE_MAPS_API_KEY=

# Weather ---------------------------------------------------------------------
WEATHER_MODE=sandbox
NWS_LIVE_ENABLED=false
# Live NWS calls require an identifying User-Agent with monitored contact info.
NWS_USER_AGENT=
NWS_API_BASE_URL=https://api.weather.gov

# Routing ---------------------------------------------------------------------
ROUTING_MODE=sandbox
VROOM_LIVE_ENABLED=false
VROOM_URL=http://127.0.0.1:3000
VROOM_HEALTH_URL=http://127.0.0.1:3000/health
VROOM_AUTHORIZATION=
VROOM_REQUEST_TIMEOUT_MS=10000
# Coordinate-based VROOM requests require an approved routing engine. The
# included no-key VROOM profile supports deterministic custom-matrix requests.
VROOM_ROUTER=osrm

# Optional server-issued signed Storage targets -------------------------------
# These switches do not control field-photo readiness. In authenticated
# VITE_STORYOPS_DATA_MODE=supabase mode, the private job-media bucket, browser
# RLS, read-back, and field-media-finalize Edge boundary are mandatory.
SIGNED_STORAGE_TARGETS_MODE=sandbox
SIGNED_STORAGE_TARGETS_LIVE_ENABLED=false
STORAGE_BUCKET_JOB_PHOTOS=job-media
# Dedicated worker activation and credential for orphan-upload cleanup. The
# mode is disabled, manual, or scheduled. The token must be an independent
# random value of at least 32 bytes and must not reuse a Supabase, provider,
# webhook, scheduling, post-service, or transactional-worker credential.
SCOPE_PHOTO_CLEANUP_MODE=disabled
SCOPE_PHOTO_CLEANUP_TOKEN=
SCOPE_PHOTO_CLEANUP_SCHEDULE_INTERVAL_SECONDS=900

# Accounting export ------------------------------------------------------------
QUICKBOOKS_MODE=sandbox
QUICKBOOKS_EXPORT_ENABLED=false

# Backup / restore --------------------------------------------------------------
BACKUP_OUTPUT_DIR=./backups
# Enabling hosted Storage export also requires SUPABASE_URL and the service-role
# key in the process environment. Do not put that key in a VITE_ variable.
BACKUP_INCLUDE_STORAGE=false
# Exact lowercase SHA-256 printed by the completed backup command and retained in
# a separate trusted system. Set only while restoring that exact backup. Never
# derive this value from the received/archive copy at restore time; doing so
# would not authenticate a replaced manifest.
STORYOPS_BACKUP_MANIFEST_SHA256=
# Independent high-entropy secret of at least 32 bytes used only to sign fresh,
# isolated restore evidence. Configure the same value only on the trusted restore
# runner and the trusted-pilot-proof Edge secret store. Never reuse a database,
# JWT, service-role, provider, webhook, or cleanup secret; never expose as VITE_*.
PILOT_RESTORE_PROOF_HMAC_SECRET=

# Local/runtime health probes ---------------------------------------------------
# Production telemetry collector and alerting configuration are deployment
# decisions; no unused placeholder credentials are declared in this template.
HEALTHCHECK_APP_URL=http://127.0.0.1:8080/healthz
HEALTHCHECK_VROOM_URL=http://127.0.0.1:3000/health
